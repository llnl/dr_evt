FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        ccache \
        gcc-14 \
        g++-14 \
        clang-18 \
        libboost-all-dev \
        python3 \
        python3-pip \
        python3-venv \
        libopenmpi-dev \
        openmpi-bin \
        libprotobuf-dev \
        protobuf-compiler \
        libgrpc++-dev \
        protobuf-compiler-grpc \
        libhiredis-dev \
        redis-server \
        git \
        ca-certificates \
        doxygen \
        graphviz \
    && rm -rf /var/lib/apt/lists/*
