# Rootless Podman image for the DR_EVT gRPC client.
# It starts an interactive shell in the host-mounted /data directory.

FROM ubuntu:24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

# LC rootless Podman maps only the invoking UID/GID, so APT cannot switch to
# its _apt sandbox account. Keep package downloads under the container root.
RUN apt-get -o APT::Sandbox::User=root update \
    && apt-get -o APT::Sandbox::User=root install --yes --no-install-recommends \
        bc \
        build-essential \
        ca-certificates \
        cmake \
        git \
        ninja-build \
        pkg-config \
        libboost-all-dev \
        libgrpc++-dev \
        libhiredis-dev \
        libprotobuf-dev \
        libssl-dev \
        protobuf-compiler \
        protobuf-compiler-grpc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

RUN cmake -S . -B /build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/dr-evt \
        -DDR_EVT_ENABLE_PROTOBUF=ON \
        -DDR_EVT_ENABLE_GRPC=ON \
        -DDR_EVT_WITH_REDIS=ON \
        -DDR_EVT_WITH_SER20=ON \
    && cmake --build /build \
    && cmake --install /build

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get -o APT::Sandbox::User=root update \
    && apt-get -o APT::Sandbox::User=root install --yes --no-install-recommends \
        bc \
        libgrpc++-dev \
        libhiredis1.1 \
        libprotobuf-dev \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/dr-evt /opt/dr-evt

WORKDIR /input
VOLUME ["/input"]

ENTRYPOINT ["/bin/bash"]
