# Rootless Podman image for the DR_EVT gRPC simulation server.
# Build with: podman build -f containers/podman/server/Containerfile -t dr-evt-server .

FROM ubuntu:24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        ninja-build \
        pkg-config \
        libboost-all-dev \
        libhiredis-dev \
        libgrpc++-dev \
        libprotobuf-dev \
        protobuf-compiler \
        protobuf-compiler-grpc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

RUN cmake -S . -B /build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/dr-evt \
        -DDR_EVT_ENABLE_PROTOBUF=ON \
        -DDR_EVT_ENABLE_GRPC=ON \
        -DDR_EVT_WITH_SER20=ON \
        -DDR_EVT_WITH_REDIS=ON \
    && cmake --build /build \
    && cmake --install /build

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        libboost-all-dev \
        libhiredis1.1.0 \
        libgrpc++-dev \
        libprotobuf-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/dr-evt /opt/dr-evt

WORKDIR /data
VOLUME ["/data"]
EXPOSE 50051

ENTRYPOINT ["/opt/dr-evt/bin/dr_evt_server"]
CMD ["0.0.0.0:50051"]
