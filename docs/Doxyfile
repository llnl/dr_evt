# Doxyfile for DR_EVT

PROJECT_NAME           = "DR_EVT Scheduler"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "SLURM-style HPC Job Scheduler Simulator"

OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO

# Input
# Keep this list explicit and non-recursive.  A recursive scan of ``src/`` can
# follow generated build-directory links into third-party dependency sources.
INPUT                  = src/ \
                         src/mpi/ \
                         src/params/ \
                         src/proto/ \
                         src/sim/ \
                         src/trace/ \
                         src/utils/ \
                         python/dr_evt_bindings.cpp
FILE_PATTERNS          = *.hpp *.cpp *.md
RECURSIVE              = NO
# INPUT is deliberately limited to project directories above.  Do not list
# excluded dependency/build trees here: Doxygen scans every EXCLUDE directory
# while constructing its exclusion list.
EXCLUDE                =
EXCLUDE_PATTERNS       =

# Output formats
# Sphinx renders this XML through Breathe, so the C++ API uses the same theme
# and navigation as the rest of the documentation site.
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

# Documentation extraction
EXTRACT_ALL            = YES
# The developer reference documents implementation state as well as the
# public API.  Private/protected members are essential when maintaining the
# scheduler, parser, and trace-buffer invariants.
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
# Implementation helpers are often kept in anonymous namespaces to give them
# internal linkage.  Include those functions and variables in the developer
# reference as well.
EXTRACT_ANON_NSPACES   = YES

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO

# Preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO

# Diagrams
HAVE_DOT               = YES
CLASS_DIAGRAMS         = YES
COLLABORATION_GRAPH    = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES

DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

# Index generation
ALPHABETICAL_INDEX     = YES
COLS_IN_ALPHA_INDEX    = 3

# References
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

# Warnings
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES

# Sphinx owns the narrative documentation and Doxygen supplies its C++ API.
USE_MDFILE_AS_MAINPAGE =
