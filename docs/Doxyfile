# Doxyfile for DR_EVT

PROJECT_NAME           = "DR_EVT Scheduler"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "SLURM-style HPC Job Scheduler Simulator"

OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO

# Input
# Keep this list explicit and non-recursive.  A recursive scan of ``src/`` can
# follow generated build-directory links into third-party dependency sources.
INPUT                  = src/ \
                         src/mpi/ \
                         src/params/ \
                         src/proto/ \
                         src/sim/ \
                         src/trace/ \
                         src/utils/ \
                         python/dr_evt_bindings.cpp
FILE_PATTERNS          = *.hpp *.cpp *.tpp *.md
EXTENSION_MAPPING      = tpp=C++
INCLUDE_PATH           = src/
RECURSIVE              = NO
# INPUT is deliberately limited to project directories above.  Do not list
# excluded dependency/build trees here: Doxygen scans every EXCLUDE directory
# while constructing its exclusion list.
EXCLUDE                =
EXCLUDE_PATTERNS       =

# Output formats
# Sphinx renders this XML through Breathe, so the C++ API uses the same theme
# and navigation as the rest of the documentation site.
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

# Documentation extraction
EXTRACT_ALL            = YES
# The developer reference documents implementation state as well as the
# public API.  Private/protected members are essential when maintaining the
# scheduler, parser, and trace-buffer invariants.
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
# Implementation helpers are often kept in anonymous namespaces to give them
# internal linkage.  Include those functions and variables in the developer
# reference as well.
EXTRACT_ANON_NSPACES   = YES

# Source listings and Graphviz output are not consumed by Breathe. Generating
# them substantially increases the Read the Docs post-install time while the
# published Sphinx site uses only Doxygen's declaration XML.
SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO

# Preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
# Include the optional serialization API in the generated reference. Ser20 is
# enabled in supported builds, but Doxygen does not read the generated CMake
# configuration header.
PREDEFINED             = DR_EVT_HAS_SER20=1 \
                         "ENABLE_CUSTOM_SER20(x)="

# Doxygen 1.8 represents C++20 concepts as variables in XML. Breathe then
# passes an invalid ``template<...> concept ...`` variable declaration to the
# Sphinx C++ domain. Keep the concept in the function signatures, but omit its
# misclassified standalone declaration until the older Doxygen format is no
# longer supported.
EXCLUDE_SYMBOLS        = seed_hashable

# Diagrams
# The XML-only Breathe build does not publish Doxygen's generated diagrams.
# In particular, whole-project call and caller graphs can exceed the hosted
# documentation build timeout.
HAVE_DOT               = NO
# CLASS_DIAGRAMS is obsolete; TEXT is what Doxygen substituted for it.
CLASS_GRAPH            = TEXT
COLLABORATION_GRAPH    = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = NO
DIRECTORY_GRAPH        = NO

# Index generation
ALPHABETICAL_INDEX     = YES

# References
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

# Warnings
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES

# Sphinx owns the narrative documentation and Doxygen supplies its C++ API.
USE_MDFILE_AS_MAINPAGE =
